generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model messages {
  message_id                        Int                    @id @default(autoincrement())
  sender_id                         Int?
  receiver_id                       Int?
  post_id                           Int?
  message_text                      String?                @db.Text
  sent_at                           DateTime?              @default(now()) @db.Timestamp(0)
  read_status                       messages_read_status?  @default(unread)
  message_type                      messages_message_type? @default(text)
  deleted_by_sender                 Boolean?               @default(false)
  deleted_by_receiver               Boolean?               @default(false)
  is_edited                         Boolean?               @default(false)
  sender                            users?                 @relation("messages_sender_idTousers", fields: [sender_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "messages_ibfk_1")
  receiver                          users?                 @relation("messages_receiver_idTousers", fields: [receiver_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "messages_ibfk_2")
  posts                             posts?                 @relation(fields: [post_id], references: [post_id], onDelete: Cascade, onUpdate: NoAction, map: "messages_ibfk_3")

  @@index([post_id], map: "post_id")
  @@index([receiver_id], map: "receiver_id")
  @@index([sender_id], map: "sender_id")
}

model posts {
  post_id     Int             @id @default(autoincrement())
  property_id Int?
  user_id     Int?
  post_type   posts_post_type
  created_at  DateTime?       @default(now()) @db.Timestamp(0)
  updated_at  DateTime?       @default(now()) @db.Timestamp(0)
  messages    messages[]
  properties  properties?     @relation(fields: [property_id], references: [property_id], onDelete: Cascade, onUpdate: NoAction, map: "posts_ibfk_1")
  users       users?          @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "posts_ibfk_2")

  @@index([property_id], map: "property_id")
  @@index([user_id], map: "user_id")
}

model properties {
  property_id     Int               @id @default(autoincrement())
  user_id         Int?
  title           String            @db.VarChar(255)
  address         String            @db.Text
  city            String?           @db.VarChar(100)
  price           Decimal?          @db.Decimal(15, 2)
  type            properties_type
  description     String?           @db.Text
  posts           posts[]
  users           users?            @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "properties_ibfk_1")
  property_images property_images[]

  @@index([user_id], map: "user_id")
}

model property_images {
  image_id             Int         @id @default(autoincrement())
  property_id          Int?
  image_url            String?     @db.VarChar(512)
  cloudinary_public_id String?     @db.VarChar(255)
  properties           properties? @relation(fields: [property_id], references: [property_id], onDelete: Cascade, onUpdate: NoAction, map: "property_images_ibfk_1")

  @@index([property_id], map: "property_id")
}

model users {
  user_id                              Int          @id @default(autoincrement())
  name                                 String       @db.VarChar(255)
  email                                String       @unique(map: "email") @db.VarChar(255)
  phone_number                         String?      @db.VarChar(20)
  password                             String       @db.VarChar(255)
  address                              String?      @db.Text
  profile_picture_url                  String?      @db.VarChar(512)
  profile_picture_cloudinary_id        String?      @db.VarChar(255)
  sent_messages                     messages[]             @relation("messages_sender_idTousers")
  received_messages                 messages[]             @relation("messages_receiver_idTousers")
  posts                                posts[]
  properties                           properties[]
}

enum posts_post_type {
  sell
  rent
}

enum messages_read_status {
  unread
  read
  delivered
}

enum properties_type {
  flat
  house
  commercial
}

enum messages_message_type {
  text
  image
  file
}
